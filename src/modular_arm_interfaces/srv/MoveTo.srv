# Request: target end-effector position in the arm base frame (meters),
# desired end-effector pitch (radians, 0 = horizontal, -pi/2 = pointing straight down),
# elbow configuration, gripper, and execution duration.
float64 x
float64 y
float64 z
float64 pitch
string elbow            # "up" or "down" can also be "auto" to let the planner choose
float64 gripper         # 0.0 = fully open, 1.0 = fully closed
float64 duration_sec    # time to execute the trajectory, e.g. 2.0
---
bool success
string message
float64[] joint_angles  # [theta1, theta2, theta3, theta4, finger_left, finger_right] actually commanded, radians/meters
