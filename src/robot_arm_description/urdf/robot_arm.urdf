<?xml version="1.0"?>
<robot name="robot_arm">

  <!-- ===== MATERIALS ===== -->
  <material name="black"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="blue"><color rgba="0.2 0.5 0.9 1"/></material>
  <material name="red"><color rgba="0.9 0.2 0.2 1"/></material>
  <material name="green"><color rgba="0.2 0.9 0.3 1"/></material>

  <!-- Anchors base_link to the world origin so robot_state_publisher
       publishes a world -> base_link static TF frame for Foxglove/RViz. -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- BASE LINK: Alt_Kasa                                         -->
  <!-- ============================================================ -->
  <link name="base_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Alt_Kasa.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="-0.05 0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.12 0.07"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="5.0" velocity="3.0"/>
  </joint>

  <link name="link1">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 3.14159"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Alt_Govde.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="-0.02 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5.0" velocity="3.0"/>
  </joint>

  <link name="link2">
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Alt_Kol.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.03 0.15"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.047 0 0.1925" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5.0" velocity="3.0"/>
  </joint>

  <link name="link3">
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 3.14159 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/On_Kol.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.07 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.04 0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.141 0 -0.001" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5.0" velocity="3.0"/>
  </joint>

  <link name="link4">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0.007 0 0" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Bilek.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.017 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.04 0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="gripper_joint" type="fixed">
    <parent link="link4"/>
    <child link="gripper_link"/>
    <origin xyz="0.052 0 -0.008" rpy="0 0 0"/>
  </joint>

  <link name="gripper_link">
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/El_Ust.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.005"/>
      </geometry>
    </collision>
  </link>

  <link name="finger_right_link">
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.04 0.008" rpy="3.14159 0 0.785"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Parmak_2_X_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.035 -0.019 0.007" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.005 0.005"/>
      </geometry>
    </collision>
  </link>

  <joint name="finger_right_joint" type="prismatic">
    <parent link="gripper_link"/>
    <child link="finger_right_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.015" effort="1.0" velocity="1.0"/>
  </joint>

  <link name="finger_left_link">
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0.04 0.004" rpy="0 0 -0.785"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Parmak_2_X_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.035 0.019 0.007" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.005 0.005"/>
      </geometry>
    </collision>
  </link>
  <joint name="finger_left_joint" type="prismatic">
    <parent link="gripper_link"/>
    <child link="finger_left_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.015" effort="1.0" velocity="1.0"/>
  </joint>

   <link name="cap_link">
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.004" rpy="3.14159 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/El.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.008"/>
      </geometry>
    </collision>
    </link>
    <joint name="cap_joint" type="fixed">
      <parent link="gripper_link"/>
      <child link="cap_link"/>
      <origin xyz="0 0 0.008" rpy="0 0 0"/> 
    </joint>

</robot>
