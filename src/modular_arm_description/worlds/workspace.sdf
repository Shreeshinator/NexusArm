<?xml version="1.0"?>
<sdf version="1.9">
  <world name="workspace">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
    </scene>
    <light type="directional" name="sun">
      <direction>-0.5 -0.3 -1.0</direction>
      <diffuse>0.8 0.8 0.7 1.0</diffuse>
      <specular>0.3 0.3 0.3 1.0</specular>
    </light>
    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table: clear of arm base_link (cylinder r=0.04 at x=0).
         Table near edge at x=0.22-0.175=0.045 > 0.04 (arm max x). -->
    <model name="table">
      <static>true</static>
      <pose>0.22 0 0.03 0 0 0</pose>
      <link name="table_link">
        <visual name="visual">
          <geometry><box><size>0.35 0.30 0.06</size></box></geometry>
          <material>
            <ambient>0.35 0.25 0.15 1.0</ambient>
            <diffuse>0.35 0.25 0.15 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.35 0.30 0.06</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Blocks: 0.04 m cubes, dropped from ~24 mm above table surface -->
    <model name="red_block">
      <pose>0.24 0.06 0.10 0 0 0</pose>
      <link name="block_link">
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>1.0 0.2 0.2 1.0</ambient>
            <diffuse>1.0 0.2 0.2 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        </collision>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.33e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.33e-05</iyy><iyz>0</iyz>
            <izz>1.33e-05</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <model name="green_block">
      <pose>0.20 -0.04 0.10 0 0 0</pose>
      <link name="block_link">
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.2 1.0 0.2 1.0</ambient>
            <diffuse>0.2 1.0 0.2 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        </collision>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.33e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.33e-05</iyy><iyz>0</iyz>
            <izz>1.33e-05</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <model name="blue_block">
      <pose>0.26 0.00 0.10 0 0 0</pose>
      <link name="block_link">
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.2 0.2 1.0 1.0</ambient>
            <diffuse>0.2 0.2 1.0 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        </collision>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.33e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.33e-05</iyy><iyz>0</iyz>
            <izz>1.33e-05</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- Front camera: angled view of the workspace -->
    <model name="cam_front">
      <static>true</static>
      <pose>0.40 0 0.28 0 0.9 3.14</pose>
      <link name="camera_link">
        <visual name="visual">
          <geometry><box><size>0.01 0.01 0.01</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.01 0.01 0.01</size></box></geometry>
        </collision>
        <sensor name="camera" type="camera">
          <always_on>true</always_on>
          <visualize>true</visualize>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.0453</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.01</near>
              <far>10.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
