<?xml version="1.0"?>
<robot name="modular_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =========================================================
       Link lengths. Keep these in sync with modular_arm_kinematics/fk.py
       and ik.py (L0, L1, L2, L3) -- they are the single source of truth
       for the analytical kinematics used later.
       ========================================================= -->
  <xacro:property name="L0" value="0.06"/>   <!-- base stand height (ground -> shoulder) -->
  <xacro:property name="L1" value="0.12"/>   <!-- shoulder -> elbow (upper arm) -->
  <xacro:property name="L2" value="0.12"/>   <!-- elbow -> wrist (forearm) -->
  <xacro:property name="L3" value="0.08"/>   <!-- wrist -> end effector tip -->
  <xacro:property name="link_radius" value="0.015"/>

  <xacro:property name="joint_effort" value="5.0"/>
  <xacro:property name="joint_velocity" value="2.0"/>

  <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="orange"><color rgba="0.9 0.45 0.1 1.0"/></material>
  <material name="dark"><color rgba="0.2 0.2 0.2 1.0"/></material>

  <!-- Reusable inertial block for a cylinder-ish link -->
  <xacro:macro name="simple_inertial" params="mass">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </xacro:macro>

  <!-- Reusable macro for an arm segment: a cylinder along its local +Z or +X,
       here modeled along the joint's rotation axis offset for visualization. -->
  <xacro:macro name="segment_link" params="name length material_name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${link_radius}" length="${length}"/></geometry>
        <material name="${material_name}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${link_radius}" length="${length}"/></geometry>
      </collision>
      <xacro:simple_inertial mass="0.15"/>
    </link>
  </xacro:macro>

  <!-- =========================================================
       world -> base_link (fixed). Keeps the robot pinned for Gazebo.
       ========================================================= -->
  <link name="world"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${L0/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="${L0}"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${L0/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="${L0}"/></geometry>
    </collision>
    <xacro:simple_inertial mass="0.4"/>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- =========================================================
       joint1: base yaw (rotates the whole arm plane about Z)
       ========================================================= -->
  <link name="link1">
    <visual>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <xacro:simple_inertial mass="0.1"/>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 ${L0}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <!-- =========================================================
       joint2: shoulder pitch -> link2 (upper arm, length L1)
       ========================================================= -->
  <xacro:segment_link name="link2" length="${L1}" material_name="orange"/>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0" rpy="0 -1.5708 0"/>  <!-- link2's local +Z becomes world horizontal at theta2=0 -->
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <!-- =========================================================
       joint3: elbow pitch -> link3 (forearm, length L2)
       ========================================================= -->
  <xacro:segment_link name="link3" length="${L2}" material_name="grey"/>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 ${L1}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.61799" upper="2.61799" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <!-- =========================================================
       joint4: wrist pitch -> link4 (wrist link, length L3)
       ========================================================= -->
  <xacro:segment_link name="link4" length="${L3}" material_name="orange"/>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 ${L2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <!-- =========================================================
       end_effector: fixed frame at the tip -- mount point for a future
       gripper / camera / tool. Vision & grasping modules should target this frame.
       ========================================================= -->
  <link name="end_effector_link"/>

  <joint name="end_effector_joint" type="fixed">
    <parent link="link4"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 ${L3}" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="$(find modular_arm_description)/urdf/modular_arm.gazebo.xacro"/>

</robot>
