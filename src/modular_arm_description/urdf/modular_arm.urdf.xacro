<?xml version="1.0"?>
<robot name="modular_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="L0" value="0.06"/>   <!-- base stand height (ground -> shoulder) -->
  <xacro:property name="L1" value="0.12"/>   <!-- shoulder -> elbow (upper arm) -->
  <xacro:property name="L2" value="0.12"/>   <!-- elbow -> wrist (forearm) -->
  <xacro:property name="L3" value="0.08"/>   <!-- wrist -> end effector tip -->
  <xacro:property name="link_radius" value="0.015"/>

  <xacro:property name="joint_effort" value="5.0"/>
  <xacro:property name="joint_velocity" value="2.0"/>

  <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="orange"><color rgba="0.9 0.45 0.1 1.0"/></material>
  <material name="dark"><color rgba="0.2 0.2 0.2 1.0"/></material>

  <!-- Reusable inertial block. Uses a safe constant inertia (0.001) that
       DART/ODE can handle numerically. Physically-exact inertias for small
       links produce near-zero values (1e-7..1e-8) that overflow to NaN
       during dynamics, crashing the ODE collision detector.
       include_com: shift the COM to mid-link (z = length/2). -->
  <xacro:macro name="simple_inertial" params="mass length include_com:=true">
    <inertial>
      <xacro:if value="${include_com}">
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
      </xacro:if>
      <mass value="${mass}"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </xacro:macro>

  <!-- Reusable macro for an arm segment: a cylinder along its local +Z or +X,
       here modeled along the joint's rotation axis offset for visualization. -->
  <xacro:macro name="segment_link" params="name length material_name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${link_radius}" length="${length}"/></geometry>
        <material name="${material_name}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${link_radius}" length="${length}"/></geometry>
      </collision>
      <xacro:simple_inertial mass="0.15" length="${length}"/>
    </link>
  </xacro:macro>

  <!-- =========================================================
       world -> base_link (fixed). Keeps the robot pinned for Gazebo.
       ========================================================= -->
  <link name="world"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${L0/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="${L0}"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${L0/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="${L0}"/></geometry>
    </collision>
    <xacro:simple_inertial mass="0.4" length="${L0}"/>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- =========================================================
       joint1: base yaw (rotates the whole arm plane about Z)
       ========================================================= -->
  <link name="link1">
    <visual>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <xacro:simple_inertial mass="0.1" length="0.0" include_com="false"/>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 ${L0}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <!-- =========================================================
       joint2: shoulder pitch -> link2 (upper arm, length L1)
       ========================================================= -->
  <xacro:segment_link name="link2" length="${L1}" material_name="orange"/>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0" rpy="0 -1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="3.14159" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <!-- =========================================================
       joint3: elbow pitch -> link3 (forearm, length L2)
       ========================================================= -->
  <xacro:segment_link name="link3" length="${L2}" material_name="grey"/>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 ${L1}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <!-- =========================================================
       joint4: wrist pitch -> link4 (wrist link, length L3)
       ========================================================= -->
  <xacro:segment_link name="link4" length="${L3}" material_name="orange"/>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 ${L2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>
  <!-- =========================================================
       end effector link (fixed to the wrist)
       ========================================================= -->
  <link name="end_effector_link"/>

  <joint name="end_effector_joint" type="fixed">
    <parent link="link4"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 ${L3}" rpy="0 0 0"/>
  </joint>

  <!-- =========================================================
       parallel-jaw gripper on the end effector
       ========================================================= -->
  <xacro:property name="gripper_spread" value="0.04"/>
  <xacro:property name="finger_length" value="0.04"/>
  <xacro:property name="finger_width" value="0.006"/>

  <link name="gripper_base">
    <visual>
      <geometry><box size="0.025 0.05 0.015"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="0.025 0.05 0.015"/></geometry>
    </collision>
    <xacro:simple_inertial mass="0.03" length="0.015" include_com="true"/>
  </link>
  <joint name="gripper_base_joint" type="fixed">
    <parent link="end_effector_link"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.006" rpy="0 0 0"/>
  </joint>

  <link name="finger_left">
    <visual>
      <origin xyz="0 0 ${finger_length/2}" rpy="0 0 0"/>
      <geometry><box size="${finger_width} ${finger_width} ${finger_length}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${finger_length/2}" rpy="0 0 0"/>
      <geometry><box size="${finger_width} ${finger_width} ${finger_length}"/></geometry>
    </collision>
    <xacro:simple_inertial mass="0.005" length="0.0" include_com="false"/>
  </link>
  <joint name="finger_left_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger_left"/>
    <origin xyz="0 ${gripper_spread/2} 0.006" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="${(gripper_spread - finger_width) / 2 - 0.001}" effort="1.0" velocity="0.1"/>
  </joint>

  <link name="finger_right">
    <visual>
      <origin xyz="0 0 ${finger_length/2}" rpy="0 0 0"/>
      <geometry><box size="${finger_width} ${finger_width} ${finger_length}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${finger_length/2}" rpy="0 0 0"/>
      <geometry><box size="${finger_width} ${finger_width} ${finger_length}"/></geometry>
    </collision>
    <xacro:simple_inertial mass="0.005" length="0.0" include_com="false"/>
  </link>
  <joint name="finger_right_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger_right"/>
    <origin xyz="0 ${-gripper_spread/2} 0.006" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="${(gripper_spread - finger_width) / 2 - 0.001}" effort="1.0" velocity="0.1"/>
  </joint>

  <!-- =========================================================
       wrist camera: mounted on gripper_base, looks forward at
       the grasp zone — critical for LeRobot policy training
       ========================================================= -->
  <link name="wrist_camera_link">
    <visual>
      <geometry><box size="0.006 0.006 0.006"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="0.006 0.006 0.006"/></geometry>
    </collision>
    <xacro:simple_inertial mass="0.001" length="0.0" include_com="false"/>
  </link>

  <joint name="wrist_camera_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="wrist_camera_link"/>
    <origin xyz="0.012 0.0 0.008" rpy="0 1.5708 0"/>
  </joint>

  <gazebo reference="wrist_camera_link">
    <sensor name="wrist_camera" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.005</near>
          <far>0.5</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <xacro:include filename="$(find modular_arm_description)/urdf/modular_arm.gazebo.xacro"/>

</robot>
