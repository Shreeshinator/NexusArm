<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>modular_arm_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files that bring up the full stack: Gazebo + robot + controllers + kinematics node. This is the one entry point future modules (vision/LLM/VLA launch files) should depend on.</description>
  <maintainer email="you@example.com">you</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>modular_arm_description</exec_depend>
  <exec_depend>modular_arm_kinematics</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
